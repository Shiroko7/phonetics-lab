{
  "name": "phonetics-lab",
  "private": true,
  "license": "Apache-2.0",
  "engines": { "node": ">=22.18.0" },
  "version": "0.1.0",
  "type": "module",
  "description": "Paste English text, get IPA phonetics on hover plus pronunciation audio.",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dict": "node scripts/prepare-assets.mjs --force",
    "common": "node scripts/prepare-assets.mjs --force",
    "precheck": "node scripts/prepare-assets.mjs",
    "check": "node scripts/check-assets.mjs && node scripts/check.mjs && node scripts/check-pronunciation.mjs && node scripts/check-practice-policy.mjs && node scripts/check-benchmark.mjs && node scripts/check-phone-flags.mjs && node scripts/check-evaluation-foundation.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:benchmark": "node scripts/check-benchmark.mjs && node scripts/check-phone-flags.mjs && node scripts/check-evaluation-foundation.mjs",
    "benchmark:prepare": "node scripts/prepare-speechocean.mjs",
    "benchmark:run": "node scripts/benchmark-assessment.mjs",
    "benchmark:phones": "node scripts/evaluate-phone-flags.mjs",
    "benchmark:splits": "node scripts/benchmark-splits.mjs",
    "benchmark:boundaries:import": "node scripts/import-l2-arctic.mjs",
    "benchmark:boundaries:evaluate": "node scripts/evaluate-pronunciation.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "predev:web": "node scripts/prepare-assets.mjs",
    "dev:web": "vite",
    "dev:api": "uv run --directory backend uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir app",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','tsconfig.tsbuildinfo']) require('fs').rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.12"
  }
}
